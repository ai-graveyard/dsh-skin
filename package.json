{
  "name": "dsh-skin-collection",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "description": "Theme collection and desktop plugin for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run build:plugin && next build",
    "build:plugin": "node plugin/build.mjs",
    "check": "node plugin/build.mjs --check && node scripts/validate.mjs && node scripts/check-skin-layers.mjs && node scripts/check-contrast.mjs && tsc --noEmit",
    "pack:plugin": "node scripts/package-release.mjs --dry-run",
    "release:assets": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
