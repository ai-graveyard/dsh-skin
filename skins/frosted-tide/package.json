{
  "name": "dsh-skin-frosted-tide",
  "version": "0.3.1",
  "description": "Frosted navy panels, a quiet indigo glow and a clear teal focal point.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "LICENSE",
    "README.md",
    "build.mjs",
    "index.js",
    "client.js",
    "skin.css",
    "preview.html",
    "cordis.patch.yml",
    "tokens.json",
    "skin.json",
    "locale",
    "icon.svg"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "desktop",
    "theme",
    "glassmorphism"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-graveyard/dsh-skin.git",
    "directory": "skins/frosted-tide"
  },
  "homepage": "https://dshskin.com/skins/frosted-tide",
  "bugs": {
    "url": "https://github.com/ai-graveyard/dsh-skin/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check",
    "prepack": "node build.mjs --check"
  },
  "icon": "./icon.svg"
}
