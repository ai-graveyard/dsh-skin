{
  "name": "dsh-skin-night-signal",
  "version": "0.1.0",
  "description": "A focused, high-contrast dark skin for DeepSeek Harness Web UI",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "README.md",
    "build.mjs",
    "index.js",
    "client.js",
    "skin.css",
    "preview.html",
    "cordis.patch.yml"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "theme",
    "dark-theme",
    "high-contrast"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-graveyard/dsh-skin.git",
    "directory": "skins/night-signal"
  },
  "homepage": "https://dshskin.com/skins/night-signal",
  "bugs": {
    "url": "https://github.com/ai-graveyard/dsh-skin/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check",
    "prepack": "node build.mjs --check"
  }
}
